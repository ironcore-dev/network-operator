# Aggregate L2 Trunk Interface
-- interfaces/eth1-10 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: eth1-10
  namespace: default
spec:
  deviceRef:
    name: device
  name: eth1/10
  description: Member of po10
  adminState: Up
  type: Physical
  mtu: 1500
-- interfaces/po10 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: po10
  namespace: default
spec:
  deviceRef:
    name: device
  name: po10
  description: vPC Leaf1 to Host1
  adminState: Up
  type: Aggregate
  mtu: 1500
  switchport:
    mode: Trunk
    nativeVlan: 1
    allowedVlans: [10]
  aggregation:
    controlProtocol:
      mode: Active
    memberInterfaceRefs:
      - name: eth1-10

-- state/preload --
{
  "openconfig-system:system": {
    "state": {
      "boot-time": "1784731445707000000"
    }
  },
  "openconfig-interfaces:interfaces": {
    "interface": [
      {"name": "eth1/10", "state": {"oper-status": "UP"}},
      {"name": "po10", "state": {"oper-status": "UP"}}
    ]
  }
}

-- state/expect --

{
  "openconfig-system:system": {
    "state": {
      "boot-time": "1784731445707000000"
    }
  },
  "openconfig-interfaces:interfaces": {
    "interface": [
      {
        "config": {
          "name": "eth1/10",
          "type": "iana-if-type:ethernetCsmacd",
          "description": "Member of po10",
          "enabled": true,
          "mtu": 1500
        },
        "openconfig-if-ethernet:ethernet": {
          "config": {
            "openconfig-if-aggregate:aggregate-id": "po10"
          }
        },
        "name": "eth1/10"
      },
      {
        "config": {
          "name": "po10",
          "type": "iana-if-type:ieee8023adLag",
          "description": "vPC Leaf1 to Host1",
          "enabled": true,
          "mtu": 1500,
          "tpid": "TPID_0X8100"
        },
        "openconfig-if-aggregate:aggregation": {
          "config": {
            "lag-type": "LACP"
          },
          "openconfig-vlan:switched-vlan": {
            "config": {
              "interface-mode": "TRUNK",
              "native-vlan": 1,
              "trunk-vlans": [
                10
              ]
            }
          }
        },
        "name": "po10"
      }
    ]
  }
}

-- state/delete --

{
  "openconfig-system:system": {
    "state": {
      "boot-time": "1784731445707000000"
    }
  },
  "openconfig-interfaces:interfaces": {
    "interface": [
      {
        "config": {
          "name": "eth1/10",
          "type": "iana-if-type:ethernetCsmacd",
          "enabled": false
        },
        "name": "eth1/10",
        "openconfig-if-ethernet:ethernet": {
          "openconfig-vlan:switched-vlan": {
            "config": {
              "trunk-vlans": [
                "1..4094"
              ]
            }
          }
        }
      }
    ]
  }
}
