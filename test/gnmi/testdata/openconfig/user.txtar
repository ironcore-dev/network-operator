                "role": "superuser",
                "ssh-key": "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAAAQQDSGgsAKZn/hxPMKyfwKboiOEeuL9bTqW79QfEQ8h0kpGhkFJJEWR1e3BvXpdT9KYQOaKQnNw32atULweSQQNGh6 IronCore Test",
                "username": "testplan"
              },
              "username": "testplan"
            }
          ]
        }
      }
    }
  }
}

-- state/delete --
{
  "openconfig-system:system": {
    "aaa": {
      "authentication": {
        "users": {
          "user": []
        }
      }
    }
  }
}
