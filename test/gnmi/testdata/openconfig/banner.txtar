# Banner PreLogin
-- banners/banner --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Banner
metadata:
  name: banner
  namespace: default
spec:
  deviceRef:
    name: device
  type: PreLogin
  message:
    inline: "Unauthorized access is prohibited."

-- state/preload --
{
  "openconfig-system:system": {
    "state": {
      "boot-time": "1784731445707000000"
    }
  }
}

-- state/expect --
{
  "openconfig-system:system": {
    "config": {
      "login-banner": "Unauthorized access is prohibited."
    },
    "state": {
      "boot-time": "1784731445707000000"
    }
  }
}

-- state/delete --
{
  "openconfig-system:system": {
    "state": {
      "boot-time": "1784731445707000000"
    }
  }
}
