-- interfaces/eth1-3 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: eth1-3
  namespace: default
spec:
  deviceRef:
    name: device
  name: eth1/3
  description: Member of po20
  adminState: Up
  type: Physical

-- interfaces/po20 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: po20
  namespace: default
spec:
  deviceRef:
    name: device
  name: po20
  description: L3 Port-Channel to Spine1
  adminState: Up
  type: Aggregate
  mtu: 9216
  ipv4:
    addresses:
      - 10.0.2.1/30
  aggregation:
    controlProtocol:
      mode: Active
    memberInterfaceRefs:
      - name: eth1-3

-- state/preload --
{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

-- state/expect --
{
  "System": {
    "fm-items": {
