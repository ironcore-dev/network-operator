{
  "System": {
    "bd-items": {
      "bd-items": {
        "BD-list": [
          {
            "fabEncap": "vlan-100",
            "accEncap": "vxlan-10100",
            "name": "EVPN-VLAN-100"
          }
        ]
      }
    },
    "fm-items": {
      "evpn-items": {
        "adminSt": "enabled"
      },
      "nvo-items": {
        "adminSt": "enabled"
      },
      "vnsegment-items": {
        "adminSt": "enabled"
      }
    },
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

-- state/delete --
{
  "System": {
