-- interfaces/eth1-10 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: eth1-10
  namespace: default
spec:
  deviceRef:
    name: device
  name: eth1/10
  description: Member of po10
  adminState: Up
  type: Physical
  mtu: 1500

-- interfaces/po10 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: po10
  namespace: default
spec:
  deviceRef:
    name: device
  name: po10
  description: vPC Leaf1 to Host1
  adminState: Up
  type: Aggregate
  mtu: 1500
  switchport:
    mode: Trunk
    nativeVlan: 1
    allowedVlans: [10]
  aggregation:
    controlProtocol:
      mode: Active
    memberInterfaceRefs:
      - name: eth1-10

-- state/preload --
{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

-- state/expect --
{
  "System": {
    "fm-items": {
      "lacp-items": {
        "adminSt": "enabled"
      }
    },
    "intf-items": {
      "aggr-items": {
        "AggrIf-list": [
          {
            "accessVlan": "vlan-1",
            "adminSt": "up",
            "aggrExtd-items": {
              "bufferBoost": "enable"
            },
            "descr": "vPC Leaf1 to Host1",
            "id": "po10",
            "lacpVpcConvergence": "disable",
            "layer": "Layer2",
            "medium": "broadcast",
            "mode": "trunk",
            "mtu": 1500,
            "nativeVlan": "vlan-1",
            "pcMode": "active",
            "rsmbrIfs-items": {
              "RsMbrIfs-list": [
                {
                  "tDn": "/System/intf-items/phys-items/PhysIf-list[id='eth1/10']"
                }
              ]
            },
            "suspIndividual": "enable",
            "trunkVlans": "10",
            "userCfgdFlags": "admin_layer,admin_mtu,admin_state"
          }
        ]
      },
      "phys-items": {
        "PhysIf-list": [
          {
            "accessVlan": "vlan-1",
            "adminSt": "up",
            "descr": "Member of po10",
            "FECMode": "auto",
            "id": "eth1/10",
            "layer": "Layer2",
            "medium": "broadcast",
            "mode": "access",
            "mtu": 1500,
            "nativeVlan": "vlan-1",
            "physExtd-items": {
              "bufferBoost": "enable"
            },
            "userCfgdFlags": "admin_layer,admin_mtu,admin_state"
          }
        ]
      }
    },
    "stp-items": {
      "inst-items": {
        "if-items": {
          "If-list": [
            {
              "id": "eth1/10",
              "mode": "default",
              "bpdufilter": "default",
              "bpduguard": "default"
            },
            {
              "id": "po10",
              "mode": "default",
              "bpdufilter": "default",
              "bpduguard": "default"
            }
          ]
        }
      }
    },
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

-- state/delete --
{
  "System": {
    "fm-items": {
      "lacp-items": {
        "adminSt": "enabled"
      }
    },
    "intf-items": {
      "phys-items": {
        "PhysIf-list": [
          {
            "FECMode": "auto",
            "accessVlan": "vlan-1",
            "id": "eth1/10",
            "layer": "Layer2",
            "medium": "broadcast",
            "mode": "access",
            "mtu": 1500,
            "nativeVlan": "vlan-1",
            "trunkVlans": "1-4094",
            "userCfgdFlags": ""
          }
        ]
      }
    },
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}
