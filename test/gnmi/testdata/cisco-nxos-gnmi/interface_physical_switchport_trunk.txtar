          {
            "accessVlan": "vlan-1",
            "descr": "DME_UNSET_PROPERTY_MARKER",
            "FECMode": "auto",
            "id": "eth1/2",
            "layer": "Layer2",
            "mtu": 1500,
            "medium": "broadcast",
            "mode": "access",
            "nativeVlan": "vlan-1",
            "userCfgdFlags": "",
            "physExtd-items": {
              "bufferBoost": "enable"
            },
            "trunkVlans": "1-4094"
          }
        ]
      }
    },
    "stp-items": {
      "inst-items": {
        "if-items": {
          "If-list": [
            {
              "mode": "default",
              "bpdufilter": "default",
              "bpduguard": "enable",
              "id": "eth1/2"
            }
          ]
        }
      }
    }
  }
}
