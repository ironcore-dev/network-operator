-- interfaces/eth1-1 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: eth1-1
  namespace: default
spec:
  deviceRef:
    name: device
  name: eth1/1
  description: Leaf1 to Spine1
  adminState: Up
  type: Physical
  mtu: 9216
  ipv4:
    addresses:
      - 10.0.1.1/30

-- state/preload --
{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

-- state/expect --
{
  "System": {
    "intf-items": {
      "phys-items": {
        "PhysIf-list": [
          {
            "FECMode": "auto",
            "accessVlan": "unknown",
            "adminSt": "up",
            "descr": "Leaf1 to Spine1",
            "id": "eth1/1",
            "layer": "Layer3",
            "medium": "broadcast",
            "mode": "access",
            "mtu": 9216,
            "nativeVlan": "unknown",
            "physExtd-items": {
              "bufferBoost": "enable"
            },
            "rtvrfMbr-items": {
              "tDn": "/System/inst-items/Inst-list[name='default']"
            },
            "userCfgdFlags": "admin_layer,admin_mtu,admin_state"
          }
        ]
      }
    },
    "ipv4-items": {
      "inst-items": {
        "dom-items": {
          "Dom-list": [
            {
              "name": "default",
              "if-items": {
                "If-list": [
                  {
                    "addr-items": {
                      "Addr-list": [
                        {
                          "addr": "10.0.1.1/30",
                          "pref": 0,
                          "tag": 0,
                          "type": "primary"
                        }
                      ]
                    },
                    "id": "eth1/1"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

-- state/delete --
{
  "System": {
    "intf-items": {
      "phys-items": {
        "PhysIf-list": [
          {
            "FECMode": "auto",
            "accessVlan": "vlan-1",
            "id": "eth1/1",
            "layer": "Layer2",
            "medium": "broadcast",
            "mode": "access",
            "mtu": 1500,
            "nativeVlan": "vlan-1",
            "physExtd-items": {
              "bufferBoost": "enable"
            },
            "trunkVlans": "1-4094",
            "userCfgdFlags": ""
          }
        ]
      }
    },
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}
