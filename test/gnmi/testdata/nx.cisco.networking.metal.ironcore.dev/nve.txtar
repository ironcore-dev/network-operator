-- networkvirtualizationedgeconfigs/settings --
apiVersion: nx.cisco.networking.metal.ironcore.dev/v1alpha1
kind: NetworkVirtualizationEdgeConfig
metadata:
  name: settings
  namespace: default
spec:
  advertiseVirtualMAC: true
  holdDownTime: 200
  infraVLANs:
    - id: 3966

-- interfaces/lo-nve --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: lo-nve
  namespace: default
spec:
  deviceRef:
    name: device
  name: lo1
  type: Loopback
  adminState: Up
  ipv4:
    addresses:
      - 10.0.0.1/32

-- networkvirtualizationedges/nve1 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: NetworkVirtualizationEdge
metadata:
  name: nve1
  namespace: default
spec:
  deviceRef:
    name: device
  adminState: Up
  sourceInterfaceRef:
    name: lo-nve
  hostReachability: BGP
  providerConfigRef:
    apiVersion: nx.cisco.networking.metal.ironcore.dev/v1alpha1
    kind: NetworkVirtualizationEdgeConfig
    name: settings

