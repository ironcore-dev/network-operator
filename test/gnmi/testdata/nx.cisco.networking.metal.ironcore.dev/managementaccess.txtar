-- managementaccessconfigs/settings --
apiVersion: nx.cisco.networking.metal.ironcore.dev/v1alpha1
kind: ManagementAccessConfig
metadata:
  name: settings
  namespace: default
spec:
  console:
    timeout: 15m
  ssh:
    accessControlListName: MGMT-ACL

-- managementaccesses/config --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: ManagementAccess
metadata:
  name: config
  namespace: default
spec:
  deviceRef:
    name: device
  providerConfigRef:
    apiVersion: nx.cisco.networking.metal.ironcore.dev/v1alpha1
    kind: ManagementAccessConfig
    name: settings
  grpc:
    enabled: true
    port: 9339
    vrfName: default
    gnmi:
      maxConcurrentCall: 8
      keepAliveTimeout: 600s
  ssh:
    enabled: true
    timeout: 10m
    sessionLimit: 32

-- state/preload --
{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

