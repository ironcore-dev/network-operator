# Aggregate Interface without switchport or addresses on a device whose ports are routed by default (no system default switchport)
-- interfaces/eth1-3 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: eth1-3
  namespace: default
spec:
  deviceRef:
    name: device
  name: eth1/3
  description: Member of po3
  adminState: Up
  type: Physical

-- interfaces/po3 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: po3
  namespace: default
spec:
  deviceRef:
    name: device
  name: po3
  description: Routed Port-Channel
  adminState: Up
  type: Aggregate
  aggregation:
    controlProtocol:
      mode: Active
    memberInterfaceRefs:
      - name: eth1-3

-- state/preload --
{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    },
    "ethpm-items": {
      "inst-items": {
        "systemDefaultLayer": "Layer3"
      }
    }
  }
}

-- state/expect --

{
  "System": {
