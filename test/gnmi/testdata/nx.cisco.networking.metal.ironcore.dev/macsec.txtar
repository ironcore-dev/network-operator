          ]
        }
      }
    },
    "intf-items": {
      "phys-items": {
        "PhysIf-list": [
          {
            "accessVlan": "vlan-1",
            "adminSt": "up",
            "descr": "macse interface",
            "FECMode": "auto",
            "id": "eth1/1",
            "layer": "Layer2",
            "mtu": 1500,
            "medium": "broadcast",
            "mode": "access",
            "nativeVlan": "vlan-1",
            "userCfgdFlags": "admin_layer,admin_state",
            "physExtd-items": {
              "bufferBoost": "enable"
            }
          }
        ]
      }
    },
    "stp-items": {
      "inst-items": {
        "if-items": {
          "If-list": [
            {
              "bpdufilter": "default",
              "bpduguard": "default",
              "id": "eth1/1",
              "mode": "default"
            }
          ]
        }
      }
    }
  }
}

