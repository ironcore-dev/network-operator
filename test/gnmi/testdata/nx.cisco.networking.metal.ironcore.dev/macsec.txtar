-- interface/eth1-1 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: eth1-1
  namespace: default
spec:
  deviceRef:
    name: device
  name: eth1/1
  description: macse interface
  adminState: Up
  type: Physical

-- secret/secret1 --
apiVersion: v1
kind: Secret
metadata:
  name: secret1
  namespace: default
type: Opaque
data:
  key: dGVzdC1wc2s=

-- macsec/secure-layer2 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: MacSec
metadata:
  name: secure-layer2
  namespace: default
spec:
  deviceRef:
    name: device
  interfaceRef:
    name: eth1-1
  name: secure-layer2
  preSharedKeys:
    - secretRef:
        name: secret1
      connectivityKeyName: "1234567"
      algorithm: AES-128-CMAC
      startTime: "2026-01-01T00:00:00Z"
      endTime: "2027-01-01T09:34:01Z"
  policy:
    cipherSuite: GCM-AES-256
    confidentialityOffset: 30
    keyServerPriority: 8
    relayProtection: 32

-- state/preload --
{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

-- state/expect --

{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    },
    "fm-items": {
      "macsec-items": {
        "adminSt": "enabled"
      }
    },
    "kcmgr-items": {
      "keychains-items": {
        "macseckeychain-items": {
