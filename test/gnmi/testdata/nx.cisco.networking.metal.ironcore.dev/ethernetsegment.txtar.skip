# SKIP: The controller tries to get status, which is retrieved via NXAPI and not gNMI. Hence, not testable.

-- interfaces/member-port --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: member-port
  namespace: default
spec:
  deviceRef:
    name: device
  name: eth1/1
  type: Physical
  adminState: Up

-- interfaces/port-channel-10 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: port-channel-10
  namespace: default
spec:
  deviceRef:
    name: device
  name: po10
  type: Aggregate
  adminState: Up
  switchport:
    mode: Trunk
  aggregation:
    memberInterfaceRefs:
      - name: member-port

-- ethernetsegments/esi-mh --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: EthernetSegment
metadata:
  name: esi-mh
  namespace: default
spec:
  deviceRef:
    name: device
  interfaceRef:
    name: port-channel-10
  esiType: Arbitrary
  esi: "00:11:22:33:44:55:66:77:88:01"
  redundancyMode: AllActive
  designatedForwarder:
    electionMode: Default

-- state/preload --
{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

