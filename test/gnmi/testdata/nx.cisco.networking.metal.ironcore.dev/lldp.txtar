-- lldpconfigs/timers --
apiVersion: nx.cisco.networking.metal.ironcore.dev/v1alpha1
kind: LLDPConfig
metadata:
  name: settings
  namespace: default
spec:
  initDelay: 5
  holdTime: 90

-- lldps/config --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: LLDP
metadata:
  name: config
  namespace: default
spec:
  deviceRef:
    name: device
  adminState: Up
  providerConfigRef:
    apiVersion: nx.cisco.networking.metal.ironcore.dev/v1alpha1
    kind: LLDPConfig
    name: settings

-- state/preload --
{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

-- state/expect --

{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    },
    "fm-items": {
      "lldp-items": {
        "adminSt": "enabled"
      }
    },
    "lldp-items": {
      "inst-items": {
        "holdTime": 90,
        "initDelayTime": 5,
        "pcEnable": "disabled",
        "optTlvSel": "dcbxp,four-wire-pwr-mgmt,link-aggregation,max-framesize,mgmt-addr-v4,mgmt-addr-v6,port-desc,port-vlan,power-mgmt,sys-cap,sys-desc,sys-name,vlan-name"
      }
    }
  }
}

-- state/delete --

{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    },
    "fm-items": {
      "lldp-items": {
        "adminSt": "disabled"
      }
    },
    "lldp-items": {
      "inst-items": {
        "holdTime": 120,
        "initDelayTime": 2,
        "pcEnable": "disabled",
        "optTlvSel": "dcbxp,four-wire-pwr-mgmt,link-aggregation,max-framesize,mgmt-addr-v4,mgmt-addr-v6,port-desc,port-vlan,power-mgmt,sys-cap,sys-desc,sys-name,vlan-name"
      }
    }
  }
}
