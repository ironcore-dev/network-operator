-- vrfs/test-vrf --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: VRF
metadata:
  name: test-vrf
  namespace: default
spec:
  deviceRef:
    name: device
  name: test-vrf
  description: "Test VRF"

-- interfaces/eth1-1 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: eth1-1
  namespace: default
spec:
  deviceRef:
    name: device
  name: eth1/1
  description: Leaf1 to Spine1
  adminState: Up
  type: Physical
  mtu: 9216
  ipv4:
    addresses:
      - 10.0.1.1/30

-- staticroutes/test-vrf-route --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: StaticRoute
metadata:
  name: test-vrf-route
  namespace: default
spec:
  deviceRef:
    name: device
  name: test-vrf-route
  description: Default route to internet gateway
  prefix: "172.16.0.0/16"
  nextHops:
    - address: "11.0.100.1"
      metric: 15
    - address: "12.0.100.1"
      metric: 30
      interfaceRef:
        name: "eth1-1"
  vrfRef:
    name: "test-vrf"

-- state/preload --
{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

