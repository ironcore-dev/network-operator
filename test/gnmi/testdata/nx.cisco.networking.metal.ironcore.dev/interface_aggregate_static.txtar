-- interfaces/eth1-10 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: eth1-10
  namespace: default
spec:
  deviceRef:
    name: device
  name: eth1/10
  description: Member of po30
  adminState: Up
  type: Physical

-- interfaces/po30 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: po30
  namespace: default
spec:
  deviceRef:
    name: device
  name: po30
  description: Static port-channel
  adminState: Up
  type: Aggregate
  aggregation:
    controlProtocol:
      mode: Static
    memberInterfaceRefs:
      - name: eth1-10

-- state/preload --
{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    }
  }
}

-- state/expect --

{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    },
    "intf-items": {
      "phys-items": {
        "PhysIf-list": [
          {
            "accessVlan": "vlan-1",
            "adminSt": "up",
            "descr": "Member of po30",
            "FECMode": "auto",
            "id": "eth1/10",
            "layer": "Layer2",
            "mtu": 1500,
            "medium": "broadcast",
            "mode": "access",
            "nativeVlan": "vlan-1",
            "userCfgdFlags": "admin_layer,admin_mtu,admin_state",
            "physExtd-items": {
              "bufferBoost": "enable"
            }
          }
        ]
      },
      "aggr-items": {
        "AggrIf-list": [
          {
            "accessVlan": "vlan-1",
            "adminSt": "up",
            "descr": "Static port-channel",
            "id": "po30",
            "lacpVpcConvergence": "disable",
            "layer": "Layer2",
            "mtu": 1500,
            "medium": "broadcast",
            "mode": "access",
            "pcMode": "on",
            "nativeVlan": "vlan-1",
            "suspIndividual": "enable",
            "userCfgdFlags": "admin_layer,admin_mtu,admin_state",
            "rsmbrIfs-items": {
              "RsMbrIfs-list": [
                {
                  "tDn": "/System/intf-items/phys-items/PhysIf-list[id='eth1/10']"
                }
              ]
            },
            "aggrExtd-items": {
              "bufferBoost": "enable"
            }
          }
        ]
      }
    },
    "stp-items": {
      "inst-items": {
        "if-items": {
          "If-list": [
            {
              "mode": "default",
              "bpdufilter": "default",
              "bpduguard": "default",
              "id": "eth1/10"
            },
            {
              "mode": "default",
              "bpdufilter": "default",
              "bpduguard": "default",
              "id": "po30"
            }
          ]
        }
      }
    },
    "fm-items": {
      "lacp-items": {
        "adminSt": "enabled"
      }
    }
  }
}

