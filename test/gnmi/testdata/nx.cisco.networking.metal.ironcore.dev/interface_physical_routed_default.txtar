# Physical Interface without addresses on a device whose ports are routed by default (no system default switchport)
-- interfaces/eth1-2 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: eth1-2
  namespace: default
spec:
  deviceRef:
    name: device
  name: eth1/2
  description: Unused routed port
  adminState: Up
  type: Physical

-- state/preload --
{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    },
    "ethpm-items": {
      "inst-items": {
        "systemDefaultLayer": "Layer3"
      }
    }
  }
}

-- state/expect --

{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    },
    "ethpm-items": {
      "inst-items": {
        "systemDefaultLayer": "Layer3"
      }
    },
    "intf-items": {
      "phys-items": {
        "PhysIf-list": [
          {
            "accessVlan": "unknown",
            "adminSt": "up",
            "descr": "Unused routed port",
            "FECMode": "auto",
            "id": "eth1/2",
            "layer": "Layer3",
            "mtu": 1500,
            "medium": "broadcast",
            "mode": "access",
            "nativeVlan": "unknown",
            "userCfgdFlags": "admin_layer,admin_state",
            "rtvrfMbr-items": {
              "tDn": "/System/inst-items/Inst-list[name='default']"
            },
            "physExtd-items": {
              "bufferBoost": "enable"
            }
          }
        ]
      }
    }
  }
}

-- state/delete --

{
  "System": {
    "procsys-items": {
      "bootTime": "1700000000"
    },
    "ethpm-items": {
      "inst-items": {
        "systemDefaultLayer": "Layer3"
      }
    },
    "intf-items": {
      "phys-items": {
        "PhysIf-list": [
          {
            "accessVlan": "unknown",
            "descr": "DME_UNSET_PROPERTY_MARKER",
            "FECMode": "auto",
            "id": "eth1/2",
            "layer": "Layer3",
            "mtu": 1500,
            "medium": "broadcast",
            "mode": "access",
            "nativeVlan": "unknown",
            "userCfgdFlags": "",
            "rtvrfMbr-items": {
              "tDn": "/System/inst-items/Inst-list[name='default']"
            },
            "physExtd-items": {
              "bufferBoost": "enable"
            },
            "trunkVlans": "1-4094"
          }
        ]
      }
    }
  }
}
