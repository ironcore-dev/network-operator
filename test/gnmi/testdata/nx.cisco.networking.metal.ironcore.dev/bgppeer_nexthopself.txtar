-- interfaces/loopback0 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: loopback0
  namespace: default
spec:
  deviceRef:
    name: device
  name: lo0
  adminState: Up
  type: Loopback
  ipv4:
    addresses:
      - 10.0.0.1/32
      - 10.0.1.1/32
  ipv6:
    addresses:
      - 2001:db8::1/128


-- bgps/bgp --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: BGP
metadata:
  name: bgp0
  namespace: default
spec:
  deviceRef:
    name: device
  asNumber: 65000
  routerId: "10.0.0.1"
  addressFamilies:
    ipv4Unicast:
      enabled: true
    ipv6Unicast:
      enabled: true

-- bgppeers/bgppeer1 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: BGPPeer
metadata:
  name: bgppeer1
  namespace: default
spec:
  deviceRef:
    name: device
  bgpRef:
    name: bgp0
  address: "10.0.0.2"
  asNumber: 65000
  description: "peering A"
  localAddress:
    interfaceRef:
      name: loopback0
  addressFamilies:
    ipv4Unicast:
      enabled: true
      nextHopSelf: true
      routeReflectorClient: true
    ipv6Unicast:
      enabled: true
      nextHopSelf: true
      routeReflectorClient: true
  ttl: 2

-- bgppeers/bgppeer2 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: BGPPeer
metadata:
  name: bgppeer2
  namespace: default
spec:
  deviceRef:
    name: device
  bgpRef:
    name: bgp0
  address: "10.0.1.2"
  asNumber: 65000
  description: "peering B"
  localAddress:
    interfaceRef:
      name: loopback0
  addressFamilies:
    ipv4Unicast:
      enabled: true
    ipv6Unicast:
      enabled: true
  ttl: 2

