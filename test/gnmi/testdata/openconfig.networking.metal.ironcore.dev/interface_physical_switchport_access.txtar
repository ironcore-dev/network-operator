# Physical Interface with Switchport Access
-- interfaces/eth1-10 --
apiVersion: networking.metal.ironcore.dev/v1alpha1
kind: Interface
metadata:
  name: eth1-10
  namespace: default
spec:
  deviceRef:
    name: device
  name: eth1/10
  description: Access port to Host
  adminState: Up
  type: Physical
  mtu: 1500
  switchport:
    mode: Access
    accessVlan: 10

-- state/preload --
{
  "openconfig-system:system": {
    "state": {
      "boot-time": "1784731445707000000"
    }
  }
}

-- state/expect --

{
  "openconfig-system:system": {
    "state": {
      "boot-time": "1784731445707000000"
    }
  },
  "openconfig-interfaces:interfaces": {
    "interface": [
      {
        "config": {
          "name": "eth1/10",
          "type": "iana-if-type:ethernetCsmacd",
          "description": "Access port to Host",
          "enabled": true,
          "mtu": 1500,
          "tpid": "TPID_0X8100"
        },
        "openconfig-if-ethernet:ethernet": {
          "openconfig-vlan:switched-vlan": {
            "config": {
              "interface-mode": "ACCESS",
              "access-vlan": 10
            }
          }
        },
        "name": "eth1/10"
      }
    ]
  }
}

-- state/delete --

{
  "openconfig-system:system": {
    "state": {
      "boot-time": "1784731445707000000"
    }
  },
  "openconfig-interfaces:interfaces": {
    "interface": [
      {
        "config": {
          "name": "eth1/10",
          "type": "iana-if-type:ethernetCsmacd",
          "enabled": false
        },
        "name": "eth1/10",
        "openconfig-if-ethernet:ethernet": {
          "openconfig-vlan:switched-vlan": {
            "config": {
              "trunk-vlans": [
                "1..4094"
              ]
            }
          }
        }
      }
    ]
  }
}
