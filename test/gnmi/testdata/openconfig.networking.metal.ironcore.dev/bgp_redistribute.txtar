        "table-connections": {
          "table-connection": [
            {
              "src-protocol": "openconfig-policy-types:DIRECTLY_CONNECTED",
              "dst-protocol": "openconfig-policy-types:BGP",
              "address-family": "openconfig-types:IPV4",
              "config": {
                "src-protocol": "openconfig-policy-types:DIRECTLY_CONNECTED",
                "dst-protocol": "openconfig-policy-types:BGP",
                "address-family": "openconfig-types:IPV4",
                "import-policy": [
                  "REDIST"
                ]
              }
            },
            {
              "src-protocol": "openconfig-policy-types:STATIC",
              "dst-protocol": "openconfig-policy-types:BGP",
              "address-family": "openconfig-types:IPV4",
              "config": {
                "src-protocol": "openconfig-policy-types:STATIC",
                "dst-protocol": "openconfig-policy-types:BGP",
                "address-family": "openconfig-types:IPV4",
                "import-policy": [
                  "REDIST"
                ]
              }
            }
          ]
        }
      }
    ]
  }
}

